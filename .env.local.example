# WADL env — copy this file to .env.local and fill in real values.
# .env.local is gitignored; .env.local.example is safe to commit.

# --- Supabase (Day 1) ---
# Project URL — public, shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://wcqqdzgsioeiwljxsuvw.supabase.co

# Anon (publishable) key — public, shipped to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SECRET. Server-only. Never prefix with NEXT_PUBLIC_.
# Bypasses RLS. Only used in server-side code (route handlers, Edge Functions, migrations).
SUPABASE_SERVICE_ROLE_KEY=

# Postgres connection string for running migrations with psql / supabase CLI.
# Get from: Supabase → Project Settings → Database → Connection string (URI).
SUPABASE_DB_URL=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Twilio (Day 4) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_FROM_NUMBER=

# --- Stripe (Day 7) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Anthropic (Chat Hub, Day 7 stretch) ---
ANTHROPIC_API_KEY=
