# Expo public env. Same Supabase project as the web app.
# Copy to .env (untracked).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_KEY

# Optional: where the marketing/web app lives. Used for cross-links from
# screens that defer to the web ("manage allocations on the web", etc.).
EXPO_PUBLIC_WEB_URL=https://wadl-pearl.vercel.app
